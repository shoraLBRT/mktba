{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "globPattern": "mktba.react/src/**/*.{ts,tsx}",
        "hooks": [
          {
            "type": "command",
            "command": "cd mktba.react && npm run lint -- --fix",
            "timeout": 30,
            "statusMessage": "Linting..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
