      "bump-minor-pre-major": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "xml",
          "path": "Directory.Build.props",
          "xpath": "/Project/PropertyGroup/Version"
        },
        {
          "type": "json",
          "path": "mktba.react/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
