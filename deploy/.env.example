# Settings of one stand (X-01, #63). Copy to deploy/.env on the server and fill in; deploy/.env is
# never committed. Staging and production differ only in this file.

# Compose project: keeps the volumes of two stands on one machine apart (mktba, mktba-staging).
COMPOSE_PROJECT_NAME=mktba
# Production or Staging.
ASPNETCORE_ENVIRONMENT=Production

# Public host names; both need DNS A/AAAA records pointing to this server.
SITE_HOST=mktba.ru
API_HOST=api.mktba.ru
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=

# Secrets: generate, for example, with `openssl rand -base64 48`.
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# Optional. GitHub App private key for feedback delivery, one line with \n for line breaks;
# empty: feedback is stored and waits as Pending.
FEEDBACK_GITHUB_PRIVATE_KEY=
# Optional. Search engines (O-12, #61): the IndexNow key (8-128 of a-z A-Z 0-9 -, public by design)
# and the meta-tag tokens of Yandex Webmaster and Google Search Console. Empty: off / no tag.
INDEXNOW_KEY=
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
# Optional. An article with no version in the language of the URL (I-08, #112): original (default,
# the original with a note, noindex) or hide (redirect to that language's home).
MISSING_TRANSLATION=
# Optional. Yandex Metrika counter, baked into the web image at build time.
METRIKA_ID=

# Optional. Image names and tag for a manual `docker compose up --build`. On a stand deployed from
# CI (X-02, #64) leave them commented out: deploy/deploy.sh sets them itself (ghcr.io/<owner>/mktba,
# sha-<commit> or the release version, web suffix -staging / -production).
# MKTBA_IMAGE_PREFIX=mktba
# MKTBA_TAG=local
# MKTBA_WEB_TAG_SUFFIX=
# Optional. Subnet of the proxy network, if 172.30.63.0/24 is taken on the server.
# PROXY_SUBNET=172.30.63.0/24

# Backups (X-04, #158; README «Резервные копии»): the `backup` service saves the database and the
# uploads into BACKUP_HOST_DIR (relative to this directory) on a cron schedule in UTC, and deploy.sh
# saves them before every migration. Rotation: the newest BACKUP_KEEP scheduled and
# BACKUP_KEEP_PRE_DEPLOY pre-deploy backups stay; manual ones (deploy.sh backup) stay until removed.
# BACKUP_HOST_DIR=./backups
# BACKUP_SCHEDULE=0 3 * * *
# BACKUP_KEEP=14
# BACKUP_KEEP_PRE_DEPLOY=5
# Optional off-site copy, off while empty: a shell command run in the backup container after every
# backup with the backup directory as $1. Keep the value in single quotes. BACKUP_PACKAGES are the
# Alpine packages it needs; its config and keys go into deploy/backup-offsite/ (mounted read-only
# at /offsite). Example with rclone (any rclone remote: another server over SFTP, S3-compatible storage):
# BACKUP_PACKAGES=rclone
# BACKUP_OFFSITE_COMMAND='rclone --config /offsite/rclone.conf copy "$1" offsite:mktba/"${1##*/}"'
BACKUP_OFFSITE_COMMAND=
BACKUP_PACKAGES=

# Alerts (X-05, #159; README «Наблюдаемость»): errors of the API go to a Telegram chat, off while
# either value is empty. Create a bot with @BotFather, add it to the chat (or write to it first) and
# put the chat id here. ALERT_STAND names the stand in the message (default: the environment).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# ALERT_STAND=staging
