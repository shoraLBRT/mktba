# Settings of one stand (X-01, #63). Copy to deploy/.env on the server and fill in; deploy/.env is
# never committed. Staging and production differ only in this file.

# Compose project: keeps the volumes of two stands on one machine apart (mktba, mktba-staging).
COMPOSE_PROJECT_NAME=mktba
# Production or Staging.
ASPNETCORE_ENVIRONMENT=Production

# Public host names; both need DNS A/AAAA records pointing to this server.
SITE_HOST=mktba.ru
API_HOST=api.mktba.ru
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=

# Secrets: generate, for example, with `openssl rand -base64 48`.
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# Optional. GitHub App private key for feedback delivery, one line with \n for line breaks;
# empty: feedback is stored and waits as Pending.
FEEDBACK_GITHUB_PRIVATE_KEY=
# Optional. Yandex Metrika counter, baked into the web image at build time.
METRIKA_ID=

# Optional. Image names and tag (a registry prefix for the CI deploy, X-02 #64).
# MKTBA_IMAGE_PREFIX=mktba
# MKTBA_TAG=local
# Optional. Subnet of the proxy network, if 172.30.63.0/24 is taken on the server.
# PROXY_SUBNET=172.30.63.0/24
