# Copy to .env and fill in production values.
# Never commit .env to version control.

# PostgreSQL connection string
ConnectionStrings__DefaultConnection=Host=<host>;Port=5432;Database=mktba;Username=mktba;Password=<password>

# JWT signing key — minimum 32 chars, change before deploy
Auth__JwtSigningKey=<your_secure_signing_key_here>

# Optional: Yandex Metrika counter ID (backend)
METRIKA_COUNTER_ID=

# Frontend Yandex Metrika counter ID — set in mktba.react/.env as VITE_METRIKA_ID
# VITE_METRIKA_ID=12345678
