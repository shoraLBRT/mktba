{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mktba;Username=mktba;Password=CHANGE_ME_IN_appsettings.local.json"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Admin": {
    "Ai": {
      "Temperature": 0.1,
      "MarkdownStylingSystemPrompt": "Ты редактор Markdown-стиля. Твоя задача: улучшить оформление markdown, пунктуацию, орфографию и читаемость.\nСтрогие ограничения:\n1) Не меняй смысл текста.\n2) Не переставляй слова и не перефразируй предложения.\n3) Не добавляй и не удаляй факты.\n4) Сохраняй исходный язык.\n5) Верни только готовый Markdown без комментариев и пояснений."
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "JwtIssuer": "mktba",
    "JwtAudience": "mktba.admin",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "RefreshCookiePath": "/auth",
    "InviteTokenLifetimeHours": 24
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Session": { "PermitLimit": 60, "WindowSeconds": 60 },
    "Ai": { "PermitLimit": 20, "WindowSeconds": 3600 },
    "Feedback": { "PermitLimit": 5, "WindowSeconds": 600 },
    "Uploads": { "PermitLimit": 30, "WindowSeconds": 3600 },
    "Analytics": { "PermitLimit": 60, "WindowSeconds": 60 }
  },
  "Analytics": {
    "RetentionDays": 180,
    "AggregationIntervalMinutes": 60
  },
  "Uploads": {
    "MaxBytes": 10485760,
    "MaxPixels": 40000000,
    "PublicBaseUrl": "",
    "Cleanup": {
      "DeleteUnused": true,
      "UnusedDays": 30,
      "IntervalHours": 6
    }
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "App_Data/uploads"
    },
    "S3": {
      "ServiceUrl": "",
      "Region": "ru-central1",
      "Bucket": "",
      "KeyPrefix": "",
      "ForcePathStyle": false
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "IndexNow": {
    "Key": "",
    "SiteUrl": "",
    "Endpoint": "https://yandex.com/indexnow",
    "BatchDelaySeconds": 5
  },
  "Feedback": {
    "GitHub": {
      "AppId": "5514770",
      "Owner": "shoraLBRT",
      "Repository": "mktba"
    },
    "SiteUrl": "",
    "Intake": {
      "MaxPerHour": 30
    },
    "Delivery": {
      "PollIntervalSeconds": 30,
      "BatchSize": 20,
      "RetryBaseSeconds": 60,
      "RetryMaxSeconds": 3600
    }
  }
}
