  "components": {
    "schemas": {
      "AdminAuthResponseDto": {
        "required": [
          "accessToken",
          "email",
          "expiresAtUtc"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AdminAuthStatusDto": {
        "required": [
          "requiresBootstrapAdmin"
        ],
        "type": "object",
        "properties": {
          "requiresBootstrapAdmin": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "AdminCleanupResultDto": {
        "required": [
          "deletedArticles",
          "deletedParagraphs",
          "message"
        ],
        "type": "object",
        "properties": {
          "deletedArticles": {
            "type": "integer",
            "format": "int32"
          },
          "deletedParagraphs": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AdminInviteTokenCreateResponseDto": {
        "required": [
          "expiresAtUtc",
          "token"
        ],
        "type": "object",
        "properties": {
